# Railway: подключите плагин Postgres, DATABASE_URL подставится сам
DATABASE_URL=
AUTH_SECRET=change-me
# адрес фронтенда на Vercel
CORS_ORIGIN=http://localhost:3000
PORT=4000

# AI-помощник (разбивка работ на этапы). Без ключа работает запасной вариант по шаблонам.
ANTHROPIC_API_KEY=
# необязательно: модель, по умолчанию claude-opus-5-5
ANTHROPIC_MODEL=
